<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Payload Box attached to TIAGo gripper_link (§4) -->
  <link name="payload_box">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
    <collision name="payload_box_collision">
      <geometry>
        <box size="0.25 0.25 0.25"/>
      </geometry>
    </collision>
    <visual name="payload_box_visual">
      <geometry>
        <box size="0.25 0.25 0.25"/>
      </geometry>
      <material name="Wood">
        <color rgba="0.6 0.4 0.2 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="payload_fixed" type="fixed">
    <parent link="gripper_link"/>
    <child link="payload_box"/>
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
  </joint>
</robot>
